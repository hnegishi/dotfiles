{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "google-drive": {
      "type": "http",
      "url": "https://drivemcp.googleapis.com/mcp/v1"
    },
    "mermaid": {
      "type": "http",
      "url": "https://chatgpt.mermaid.ai/anthropic/mcp"
    },
    "claude-docs": {
      "type": "http",
      "url": "https://api.anthropic.com/v1/pages/mcp"
    },
    "pdf-viewer": {
      "type": "http",
      "url": "https://example-server.modelcontextprotocol.io/pdf/mcp"
    },
    "pubmed": {
      "type": "http",
      "url": "https://pubmed.mcp.claude.com/mcp"
    },
    "goodnotes": {
      "type": "http",
      "url": "https://claude-mcp-api.ml.goodnotes.com/mcp"
    }
  }
}
