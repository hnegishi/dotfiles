  "statusLine": {
    "type": "command",
    "command": "input=$(cat); current_dir=$(echo \"$input\" | jq -r '.workspace.current_dir'); model=$(echo \"$input\" | jq -r '.model.display_name'); remaining=$(echo \"$input\" | jq -r '.context_window.remaining_percentage // empty'); total_input=$(echo \"$input\" | jq -r '.context_window.total_input_tokens // 0'); total_output=$(echo \"$input\" | jq -r '.context_window.total_output_tokens // 0'); dir_name=$(basename \"$current_dir\"); dir_display=\"📁 $dir_name\"; git_branch=\"\"; if git -C \"$current_dir\" rev-parse --git-dir > /dev/null 2>&1; then branch=$(git -C \"$current_dir\" --no-optional-locks symbolic-ref --short HEAD 2>/dev/null || git -C \"$current_dir\" --no-optional-locks rev-parse --short HEAD 2>/dev/null); [ -n \"$branch\" ] && git_branch=\"$branch\"; fi; context_cost_info=\"\"; if [ -n \"$remaining\" ]; then used=$(echo \"100 - $remaining\" | bc); u=$(printf \"%.0f\" \"$used\"); input_cost=$(echo \"scale=4; $total_input * 3 / 1000000\" | bc); output_cost=$(echo \"scale=4; $total_output * 15 / 1000000\" | bc); total_cost=$(echo \"scale=2; $input_cost + $output_cost\" | bc); context_cost_info=\" | Context: ${u}% | Cost: \\$${total_cost}\"; fi; LIGHT_CYAN='\\033[96m'; ORANGE='\\033[38;5;214m'; RESET='\\033[0m'; if [ -n \"$git_branch\" ]; then printf \"${LIGHT_CYAN}[%s]${RESET} %s ${ORANGE}%s${RESET}%s\" \"$model\" \"$dir_display\" \"$git_branch\" \"$context_cost_info\"; else printf \"${LIGHT_CYAN}[%s]${RESET} %s%s\" \"$model\" \"$dir_display\" \"$context_cost_info\"; fi"
  },
